{
  "name": "cohabit-landlord-demo",
  "version": "1.0.0",
  "private": true,
  "description": "coHabit: landlord dashboard and renter matching, with Google sign-in",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node tests/run-local.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.139.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260923.1": true
  },
  "dependencies": {
    "better-auth": "1.7.6"
  },
  "type": "module"
}
