// Cloudflare settings for coHabit (free Workers plan).
// Static pages in ./public, plus a small Worker (src/index.js) for /api/*:
// Google sign-in, landlords' units, renters' preferences, admin user list.
// Data lives in the D1 database "cohabit-db". See ACCOUNTS_SETUP.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cohabit-landlord-demo",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    // Any address that isn't a real file (like /landlord) loads index.html,
    // so refreshing or sharing a link always works.
    "not_found_handling": "single-page-application",
    // Only API requests run the Worker; every page and file is served as-is.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cohabit-db",
      "database_id": "0e413d91-d5f8-42ce-868c-fc382b0ca38c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Public address of the site. Local development overrides this in .dev.vars.
    "BETTER_AUTH_URL": "https://cohabit-landlord-demo.dolgorsureng.workers.dev"
  },
  // Secrets (set with `npx wrangler secret put <NAME>`, never in this file):
  //   BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, MAPTILER_KEY
  //   ANTHROPIC_API_KEY (optional: turns on the assistant's AI mode; it can cost money, see ACCOUNTS_SETUP.md)
  // Optional assistant settings as vars: ASSISTANT_MODEL, ASSISTANT_DAILY_PER_USER, ASSISTANT_DAILY_SITE, ASSISTANT_PER_MINUTE
  // Optional: PASSWORD_HASH_ITERATIONS (password hashing cost, default 100000). Email and password sign-up stays off
  // until coHabit can send email (src/email.js); DEV_EMAIL_OUTBOX=1 is for local development only (.dev.vars).
  "triggers": {
    // Daily cleanup (04:17 UTC): expired sessions, old rate-limit counters, assistant chats unused for 90 days.
    "crons": ["17 4 * * *"]
  },
  "observability": { "enabled": true }
}
