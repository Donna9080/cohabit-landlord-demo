# Copy to .dev.vars for local development (npm run dev). .dev.vars is git-ignored.
# Production values are Cloudflare secrets: npx wrangler secret put <NAME>
BETTER_AUTH_URL=http://localhost:8787
# Any long random string for local use only, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# From Google Cloud Console > Google Auth Platform > Clients (see ACCOUNTS_SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MapTiler browser key (restricted to this site and localhost). See ACCOUNTS_SETUP.md, "Maps".
MAPTILER_KEY=

# Optional: Anthropic API key for the assistant's AI mode. Leave empty for basic mode ($0).
# Costs money once free credit is used: set a spend limit first. See ACCOUNTS_SETUP.md, "AI assistant".
ANTHROPIC_API_KEY=
# Optional: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5
# ASSISTANT_MODEL=claude-haiku-5-5
